#!/bin/bash
set -ex

cd $(dirname $0)/..

if [ "$SKIP_BUILD" == "false" ]; then
    echo BUILD
    ./scripts/build
fi
if [ "$ARCH" == "${HOST_ARCH:-$ARCH}" ]; then
    echo TEST
    ./scripts/test
else
    echo "TEST skipped: binaries for ${ARCH} can not run on a ${HOST_ARCH} host"
fi
echo VALIDATE
./scripts/validate
